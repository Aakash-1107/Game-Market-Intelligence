# Copy to .env and fill in. An empty value (VAR=) counts as unset.

# --- Required for ingestion ---
# AWS IAM user with read/write access to the raw bucket (AWS console > IAM > Users > Security credentials)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# Region of the raw bucket (example value; no default, a missing value stops the script)
AWS_REGION=eu-central-1
# Name of the raw S3 bucket (no default)
AWS_BUCKET=
# IsThereAnyDeal API key (isthereanydeal.com > account > API); the daily flow fails without a working key
ITAD_API_KEY=

# --- Required for dbt build ---
# The four AWS_* variables above: dbt reads the raw files from S3.

# --- Optional — log database (Pipeline health page) ---
# Postgres connection string (Neon in production; tables in sql/ddl/). Feeds ingestion logging, the observability
# models and the dashboard's Pipeline health page. Without it, logging only warns, the daily flow builds without the
# observability models, and a manual build must do the same: dbt build --target analytics --exclude tag:observability
DATABASE_URL=

# --- Optional — manual-only scripts ---
# RapidAPI key for OpenCritic (src/ingestion/opencritic_reviews.py)
# OPENCRITIC_API_KEY=
# Unzipped PlayerCountHistory part 1 folder of {app_id}.csv files (src/ingestion/backfill_player_counts.py, one-off)
# PLAYER_COUNT_HISTORY_PART1_DIR=C:\path\to\PlayerCountHistoryPart1

# --- Optional — defaults shown ---
# DuckDB file for dbt, dashboard and flow. Normally leave unset (data/game_market.duckdb). A relative path resolves
# from game_market/; an absolute path to another project's file makes every build write there.
# DUCKDB_PATH=../data/game_market.duckdb
# Daily flow: max age in hours of the newest hourly player-count file
# FRESHNESS_MAX_AGE_HOURS=3
# Daily flow: dbt threads (more needs more RAM)
# DBT_THREADS=1
# dbt: DuckDB memory cap and spill directory (relative to game_market/)
# DUCKDB_MEMORY_LIMIT=2GB
# DUCKDB_TEMP_DIRECTORY=../data/duckdb_tmp
# dbt profile directory; dbt already finds game_market/profiles.yml when run from game_market/
# DBT_PROFILES_DIR=game_market
