# --- AWS S3 raw bucket (ingestion scripts, dbt via game_market/profiles.yml, fingerprint tool) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=eu-central-1
AWS_BUCKET=

# --- Neon Postgres: ingestion_log, pipeline_run_log, dbt_node_result (DDL in sql/ddl/) ---
# Also required by dbt (read-only attach `ops` in game_market/profiles.yml) and by the dashboard's Pipeline health page.
DATABASE_URL=

# --- API keys ---
ITAD_API_KEY=
# RapidAPI key; OpenCritic is manual-only (opencritic_reviews.py)
OPENCRITIC_API_KEY=

# --- Optional: DuckDB file (default: data/game_market.duckdb; dbt resolves a relative path from game_market/) ---
DUCKDB_PATH=
# --- Optional: daily flow freshness check, max age of the newest hourly player-count file (default: 3) ---
FRESHNESS_MAX_AGE_HOURS=
# --- Optional: dbt threads for the daily flow's dbt build (default: 1; more needs more RAM) ---
DBT_THREADS=
# --- Optional: dbt profile directory (default: game_market/, where the committed profiles.yml lives) ---
# DBT_PROFILES_DIR=game_market   (leave commented: dbt already finds game_market/profiles.yml when run from game_market/)

# --- PlayerCountHistory dataset (manual download, unzipped); folders containing {app_id}.csv files ---
# Part 1 (5-minute) is read by src/ingestion/backfill_player_counts.py; both by src/utils/check_backfill_overlap.py
PLAYER_COUNT_HISTORY_PART1_DIR=C:\path\to\PlayerCountHistoryPart1\PlayerCountHistoryPart1
PLAYER_COUNT_HISTORY_PART2_DIR=C:\path\to\PlayerCountHistoryPart2\PlayerCountHistoryPart2

# --- Legacy, only for the one-off RustFS migration scripts in src/storage/ (not needed to run the pipeline) ---
RUSTFS_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
