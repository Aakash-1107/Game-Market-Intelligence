# --- AWS S3 raw bucket (ingestion scripts, dbt via ~/.dbt/profiles.yml, fingerprint tool) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=eu-central-1
AWS_BUCKET=

# --- Neon Postgres: ingestion_log (DDL in sql/ddl/ingestion_log.sql) ---
DATABASE_URL=

# --- API keys ---
ITAD_API_KEY=
# RapidAPI key; OpenCritic is manual-only (opencritic_reviews.py)
OPENCRITIC_API_KEY=

# --- Optional: DuckDB file (default: data/game_market.duckdb) ---
DUCKDB_PATH=

# --- PlayerCountHistory dataset (manual download, unzipped); folders containing {app_id}.csv files ---
# Part 1 (5-minute) is read by src/ingestion/backfill_player_counts.py; both by src/utils/check_backfill_overlap.py
PLAYER_COUNT_HISTORY_PART1_DIR=C:\path\to\PlayerCountHistoryPart1\PlayerCountHistoryPart1
PLAYER_COUNT_HISTORY_PART2_DIR=C:\path\to\PlayerCountHistoryPart2\PlayerCountHistoryPart2

# --- Legacy, only for the one-off RustFS migration scripts in src/storage/ (not needed to run the pipeline) ---
RUSTFS_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
